#!/usr/bin/env sh
# pre-commit hook: refuse commits made directly on main/master.
# Override once with:  ALLOW_MAIN=1 git commit ...
set -eu
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
case "$BRANCH" in
  main|master)
    if [ "${ALLOW_MAIN:-0}" != "1" ]; then
      echo "pre-commit: refusing to commit on '$BRANCH'." >&2
      echo "Create a feature branch first, or set ALLOW_MAIN=1 to override." >&2
      exit 1
    fi ;;
esac
exit 0
