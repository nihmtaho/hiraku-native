{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "hiraku-coordinator",
  "share": "disabled",
  "update": "notify",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://opencode.ai/*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://developer.apple.com/*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://go.dev/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.p8",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git blame*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "node --test .agents/hiraku/tests/*.test.mjs",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "hiraku-coordinator": {
      "permissions": [
        {
          "action": "edit",
          "resource": ".agents/tasks/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": ".agents/tmp/*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-task",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-review",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-ship",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-wp-status",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "hiraku-senior",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git commit*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git merge*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git tag*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git rebase*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git reset --hard*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh pr merge*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh pr review*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh release*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh api*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "xcrun altool*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "xcrun notarytool*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "fastlane*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "codesign*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh pr create*",
          "effect": "deny"
        }
      ]
    },
    "hiraku-senior": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-coding",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-create-pr",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-contract",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-feature",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-spike-report",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "hiraku-wp-status",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "golang-testing",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "swift-concurrency-6-2",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "swift-protocol-di-testing",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "liquid-glass-design",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "accessibility",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git merge*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git tag*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git reset --hard*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh pr merge*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh pr review*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh release*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh api*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "xcrun altool*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "xcrun notarytool*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "fastlane*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "codesign*",
          "effect": "deny"
        }
      ]
    }
  }
}
